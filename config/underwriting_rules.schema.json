{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clovara Underwriting Rules v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "effectiveDate",
    "ageLimits",
    "risk",
    "excludedBreeds"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "effectiveDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "updatedBy": { "type": "string" },
    "changeNotes": { "type": "string" },
    "enabled": { "type": "boolean" },
    "ageLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minAgeMonths", "maxAgeYears"],
      "properties": {
        "minAgeMonths": { "type": "integer", "minimum": 0 },
        "maxAgeYears": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxOverallScore"],
      "properties": {
        "maxOverallScore": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "excludedBreeds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "criticalConditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excludableConditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_dog_breeds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "restricted_dog_breeds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_cat_breeds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_high_cost_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_neurological_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    },
    "excluded_dental_conditions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 0
    }
  }
}
