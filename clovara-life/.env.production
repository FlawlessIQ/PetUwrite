# Production build flags. Not secrets — these only switch finished features on.
#
# Signed-out visitors' events go to the Life functions' lifeIngest endpoint
# (BACKLOG UB5 / AO13). Switched on 2026-09-30 after the function was deployed.
# Remove this line and redeploy hosting:life to switch it off; the endpoint can stay.
VITE_ANON_INGEST=1
