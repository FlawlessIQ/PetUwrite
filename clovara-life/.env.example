# Clovara Life — build-time configuration.
#
# You do not need this file to run or deploy the app. Every value below has a
# committed default in src/auth/config.ts pointing at the pet-underwriter-ai
# project, so a missing .env can never break the build or the demo. Set these
# only to point a build somewhere else (a staging project, say).
#
# NONE OF THESE ARE SECRETS. A Firebase web API key identifies a project; it
# authorises nothing. Access control is entirely in firestore.rules and the
# console's authorised-domain list. Anything with a VITE_ prefix is inlined
# into the JS bundle at build time and is public by definition — never put a
# real secret here.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
