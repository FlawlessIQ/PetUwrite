# Local shell environment template for Clovara.
# Copy values you actually need into `.env` or `.env.local` for scripts/CLI use.
#
# The Flutter app does NOT auto-load this file at runtime.
# Mobile/web runtime config is supplied via Firebase config files or `--dart-define`.

# AI providers
OPENAI_API_KEY=
GEMINI_API_KEY=

# Stripe / payments (Cloud Functions)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
ALLOW_TEST_COUPONS=false

# Email / notifications (Cloud Functions)
SENDGRID_API_KEY=
SLACK_WEBHOOK_URL=
ADMIN_EMAIL=admin@clovara.com
NOTIFICATION_EMAIL=admin@clovara.com
FROM_EMAIL=noreply@clovara.com

# App URLs used by reimbursement / notification flows
APP_URL=http://localhost:3000
PUBLIC_APP_URL=https://pet-underwriter-ai.web.app

# Storage / alerts
STORAGE_BUCKET=pet-underwriter-ai.firebasestorage.app
PDF_EXTRACTION_FAILURE_ALERT_THRESHOLD=3
PDF_EXTRACTION_FAILURE_ALERT_THROTTLE_MINUTES=30

# Emulator hints (optional)
FUNCTIONS_EMULATOR=true
FIREBASE_EMULATOR_HOST=127.0.0.1
FUNCTIONS_REGION=us-central1

# Flutter Android Firebase setup uses dart-defines, not `.env`:
# flutter run \
#   --dart-define=FIREBASE_ANDROID_API_KEY=... \
#   --dart-define=FIREBASE_ANDROID_APP_ID=... \
#   --dart-define=FIREBASE_ANDROID_PROJECT_ID=pet-underwriter-ai \
#   --dart-define=FIREBASE_ANDROID_MESSAGING_SENDER_ID=984654950987 \
#   --dart-define=FIREBASE_ANDROID_STORAGE_BUCKET=pet-underwriter-ai.firebasestorage.app
