rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdminEmail() {
      return isAuthenticated() && request.auth.token.email in [
        'con.lawless@gmail.com'
      ];
    }

    function isCustomerRole(role) {
      return role in [0, 1] || role in ['0', '1'];
    }
    
    // Helper function to check if user is an admin (userRole == 2 or 3)
    function isAdmin() {
      return isAuthenticated() && (
        // Current production admin account.
        isAdminEmail() ||
        // Preferred: custom claim set by backend tooling.
        request.auth.token.admin == true ||
        // Fallback: role stored in Firestore user profile.
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          (
            // Accept either numeric roles (preferred) or string roles (legacy).
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole in [2, 3] ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.userRole in ['2', '3']
          )
        )
      );
    }

    // Marketing: intake channels managed in admin console
    match /intake_channels/{channelId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Marketing: discount code mirrors + restrictions managed in admin console
    match /discount_codes/{code} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Marketing: attribution sessions/events/rollups are server-written.
    // Admins may read for reporting; clients never write.
    match /attribution_sessions/{sessionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketing_events/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /marketing_rollups_daily/{dayId} {
      allow read: if isAdmin();
      allow write: if false;

      match /{subcollection}/{docId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    match /channel_spend_daily/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Pricing: versioned pricing configs managed in admin console.
    // Clients never read raw pricing configs; they use callable pricing endpoints.
    match /pricing_versions/{versionId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pricing_meta/{docId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /pricing_audit/{auditId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Benchmarking: curated market reference bands + computed portfolio snapshots.
    // NOTE: These documents are written by Cloud Functions (admin SDK) only.
    // Admin console reads them for dashboards.
    match /benchmark_reference_versions/{versionId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /benchmark_reference_current/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /portfolio_metrics_snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Admin audit log is immutable; server-written only.
    match /admin_audit_log/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }
    
    // Users collection - users can only read/write their own data
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) &&
        (
          !('userRole' in request.resource.data) ||
          isCustomerRole(request.resource.data.userRole)
        )
      );
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'userRole',
          'role',
          'admin'
        ])
      );
      allow delete: if isAdmin();
      
      // User's pets subcollection
      match /pets/{petId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
    
    // Pets collection - users can only access their own pets
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );
    }
    
    // Quotes collection - users can access their own quotes, admins can access all
    match /quotes/{quoteId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || 
        (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'humanOverride', 
          'eligibility.status',
          'eligibility.overriddenAt',
          'eligibility.overriddenBy',
          'eligibility.reviewRequestedAt',
          'eligibility.reviewRequestedBy',
          'riskScore.totalScore',
          'riskScore.overridden',
          'riskScore.originalScore',
          'status'
        ]))
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );

      // Risk score subcollection
      match /risk_score/{riskScoreId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/quotes/$(quoteId)).data.ownerId == request.auth.uid || isAdmin()
        );
        allow write: if false; // Only written by backend service
      }
      
      // Explainability subcollection
      match /explainability/{explainabilityId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/quotes/$(quoteId)).data.ownerId == request.auth.uid || isAdmin()
        );
        allow write: if false; // Only written by backend service
      }
    }

    // Underwriting cases (case-based workflow)
    match /underwriting_cases/{caseId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if false;

      // Case subcollections (medical_history, events, assessments, decisions, vet_records, etc.)
      match /{subcollection}/{docId} {
        allow create, read, update: if isAuthenticated() && (
          get(/databases/$(database)/documents/underwriting_cases/$(caseId)).data.userId == request.auth.uid || isAdmin()
        );
        allow delete: if false;
      }
      
        // Allow access to pdf_extractions subcollection
        match /pdf_extractions/{docId} {
          allow create, read, update: if isAuthenticated() && (
            get(/databases/$(database)/documents/underwriting_cases/$(caseId)).data.userId == request.auth.uid || isAdmin()
          );
          allow delete: if false;
        }
    }

    // Drafts (save & revisit) - owned by the authenticated uid.
    // NOTE: Resume via code/link is handled via Cloud Functions (resolveDraft),
    // which returns a custom token for the owning uid.
    match /drafts/{draftId} {
      allow create: if isAuthenticated() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }
    
    // Policies collection - users can access their own policies, admins can access all
    match /policies/{policyId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      // Only allow creation with proper owner ID
      allow create: if isAuthenticated() && (
        request.resource.data.ownerId == request.auth.uid
      );
      // Allow update only by owner or admin
      allow update: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid || isAdmin()
      );
      // Prevent deletion of policies
      allow delete: if false;
      
      // Claims subcollection
      match /claims/{claimId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/policies/$(policyId)).data.ownerId == request.auth.uid
        );
        allow create: if isAuthenticated() && (
          get(/databases/$(database)/documents/policies/$(policyId)).data.ownerId == request.auth.uid
        );
        allow update: if isAuthenticated() && (
          get(/databases/$(database)/documents/policies/$(policyId)).data.ownerId == request.auth.uid
        );
        allow delete: if false;
      }
    }
    
    // Risk scores collection (read-only for users, write by cloud functions)
    match /riskScores/{scoreId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
      );
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Payments collection (read-only for users, write by Stripe extension)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid
      );
      allow write: if false; // Only Stripe extension can write
    }
    
    // Admin Settings - Read: public (needed for quote flow), Write: admins only
    match /admin_settings/underwriting_rules {
      allow read: if true; // Public read access for quote eligibility checks
      allow write: if isAdmin();
    }

    // Underwriting rules history (immutable, admin-only)
    match /underwriting_rules_history/{version} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Product catalog switches should be admin-only.
    match /admin_settings/product_catalog {
      // Public read is required for unauthenticated quote flows; writes remain
      // admin-only.
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Other admin settings require authentication
    match /admin_settings/{document} {
      allow read: if isAuthenticated() && document != 'product_catalog';
      allow write: if isAdmin();
    }
    
    // Audit Logs - Read: admins only, Write: admins only, Delete: never
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Audit logs are immutable
    }
    
    // Admin-only access for analytics and reporting
    match /analytics/{document=**} {
      allow read: if isAdmin();
      allow write: if false; // Only server-side access
    }
    
    // Claims collection - admins can read/write, users can create for their policies
    match /claims/{claimId} {
      function isClaimOwner() {
        return isAuthenticated() && resource.data.ownerId == request.auth.uid;
      }

      function isClaimOwnerCreate() {
        return isAuthenticated() && request.resource.data.ownerId == request.auth.uid;
      }

      function isOperationalClaimCreateSchemaValid() {
        return request.resource.data.keys().hasOnly([
          'policyId',
          'ownerId',
          'petId',
          'incidentDate',
          'claimType',
          'claimAmount',
          'currency',
          'description',
          'attachments',
          'aiConfidenceScore',
          'aiDecision',
          'aiReasoningExplanation',
          'humanOverride',
          'status',
          'createdAt',
          'updatedAt',
          'settledAt',
          'reviewLockedBy',
          'reviewLockedAt'
        ]);
      }

      function ownerCannotSetSensitiveFieldsOnCreate() {
        return request.resource.data.aiDecision == null
          && request.resource.data.aiConfidenceScore == null
          && request.resource.data.aiReasoningExplanation == null
          && request.resource.data.humanOverride == null
          && request.resource.data.settledAt == null
          && request.resource.data.reviewLockedBy == null
          && request.resource.data.reviewLockedAt == null;
      }

      function ownerCannotChangeIdentityFields() {
        return request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.policyId == resource.data.policyId
          && request.resource.data.petId == resource.data.petId
          && request.resource.data.createdAt == resource.data.createdAt;
      }

      function ownerSensitiveFieldsUnchanged() {
        return request.resource.data.aiDecision == resource.data.aiDecision
          && request.resource.data.aiConfidenceScore == resource.data.aiConfidenceScore
          && request.resource.data.aiReasoningExplanation == resource.data.aiReasoningExplanation
          && request.resource.data.humanOverride == resource.data.humanOverride
          && request.resource.data.settledAt == resource.data.settledAt
          && request.resource.data.reviewLockedBy == resource.data.reviewLockedBy
          && request.resource.data.reviewLockedAt == resource.data.reviewLockedAt;
      }

      // Admins can read all claims, users can read their own
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
      // Users can create claims - allow creation with proper ownerId
      allow create: if isAuthenticated() && (
        isClaimOwnerCreate() &&
        isOperationalClaimCreateSchemaValid() &&
        request.resource.data.keys().hasAll([
          'policyId',
          'ownerId',
          'petId',
          'incidentDate',
          'claimType',
          'status',
          'createdAt',
          'updatedAt'
        ]) &&
        (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted') &&
        ownerCannotSetSensitiveFieldsOnCreate()
      );
      // Allow updates: admins always, users for their own claims in certain statuses
      // IMPORTANT: Only admins/server should advance claim lifecycle status beyond user submission.
      // Owners may edit drafts, and (optionally) add attachments/notes while under review.
      allow update: if isAdmin() || (
        isClaimOwner() && (
          // Draft: owner can edit claim details and submit.
          (
            resource.data.status == 'draft' &&
            ownerCannotChangeIdentityFields() &&
            (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted') &&
            // Prevent owners from setting server-managed fields even in draft.
            request.resource.data.aiDecision == null &&
            request.resource.data.aiConfidenceScore == null &&
            request.resource.data.aiReasoningExplanation == null &&
            request.resource.data.humanOverride == null &&
            request.resource.data.settledAt == null &&
            request.resource.data.reviewLockedBy == null &&
            request.resource.data.reviewLockedAt == null
          )
          ||
          // Submitted/Processing: owner can only adjust attachments/description (no status/AI/payout changes).
          (
            (resource.data.status == 'submitted' || resource.data.status == 'processing') &&
            ownerCannotChangeIdentityFields() &&
            request.resource.data.status == resource.data.status &&
            ownerSensitiveFieldsUnchanged() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'attachments',
              'description',
              'updatedAt'
            ])
          )
        )
      );
      // Never allow deletion of claims
      allow delete: if false;

      // Claim attachment metadata records (used for deterministic server-side extraction)
      match /attachments/{attachmentId} {
        function isClaimOwnerByLookup() {
          return isAuthenticated() &&
            get(/databases/$(database)/documents/claims/$(claimId)).data.ownerId == request.auth.uid;
        }

        allow read: if isAdmin() || isClaimOwnerByLookup();

        // Owners can create queued attachment records with safe metadata only.
        allow create: if isClaimOwnerByLookup() &&
          request.resource.data.keys().hasOnly([
            'downloadUrl',
            'storagePath',
            'fileName',
            'contentType',
            'uploadedAt',
            'uploadedBy',
            'extractionStatus'
          ]) &&
          request.resource.data.uploadedBy == request.auth.uid &&
          request.resource.data.extractionStatus == 'queued';

        // Owners cannot update or delete attachment records; server automation owns status/text.
        allow update, delete: if isAdmin();
      }
      
      // Payout records - owner can read their own, only system can write
      match /payout/{payoutId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/claims/$(claimId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        allow write: if false; // Only server-side (Cloud Functions / Backend)
      }
      
      // AI audit trails - owner can read, system can write
      match /ai_audit_trail/{logId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/claims/$(claimId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        allow write: if false; // Only server-side (Admin SDK bypasses rules)
      }
      
      // Payout audit trails - admin only
      match /payout_audit_trail/{logId} {
        allow read: if isAdmin();
        allow write: if false; // Only server-side
      }
      
      // Document analysis metadata - owner can read, system writes
      match /documents/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/claims/$(claimId)).data.ownerId == request.auth.uid
          || isAdmin()
        );
        allow write: if false; // Only server-side
      }
    }
    
    // Model Training Data collection - admins only, system writes
    match /model_training_data/{trainingDataId} {
      allow read: if isAdmin();
      allow create: if isAdmin(); // Auto-generated by ClaimsService
      allow update, delete: if false; // Training data is immutable
    }
    
    // Payout Audit Trail collection - top-level audit logs for reconciliation
    match /payout_audit_trail/{auditId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Payouts collection - for tracking all payout operations
    match /payouts/{payoutId} {
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.ownerId == request.auth.uid
      );
      allow write: if false; // Only Cloud Functions can write
    }
    
    // Reconciliation Runs collection - system health monitoring
    match /reconciliation_runs/{runId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    // AI Training Data collections - for continuous model improvement
    match /ai_training_batches/{batchId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
    
    match /ai_training_data/{batchId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
      
      // Training records subcollection
      match /records/{recordId} {
        allow read: if isAdmin();
        allow write: if false; // Only Cloud Functions can write
      }
    }
    
    // ═══════════════════════════════════════════════════════════════════════
    // CLOVARA LIFE (clovara-life.web.app)
    //
    // Purely additive. Nothing above this comment is changed by this block, and
    // nothing in it references the underwriting collections. Life shares the
    // auth user pool with the underwriting product but not its data: `users/`
    // carries userRole, admin claims and a large reviewed rules block, so Life
    // members live under `households/` instead.
    //
    // Model: a household owns pets; users belong to households. Membership is
    // held twice on the document — `members` (a map, carrying roles) and
    // `memberIds` (an array) — because Firestore cannot query map keys and both
    // these rules and the "find my household" query need to. A test asserts the
    // two stay in step.
    // ═══════════════════════════════════════════════════════════════════════

    function lifeHousehold(householdId) {
      return get(/databases/$(database)/documents/households/$(householdId)).data;
    }

    function lifeIsMember(householdId) {
      return isAuthenticated() && request.auth.uid in lifeHousehold(householdId).memberIds;
    }

    match /households/{householdId} {
      // `array-contains` on memberIds is the only query this permits, which is
      // exactly the lookup ensureHousehold() performs.
      allow read: if isAuthenticated() && request.auth.uid in resource.data.memberIds;

      // You may only create a household you are the sole founding member of.
      // Without this, anyone could create a household listing someone else.
      //
      // The field list is an ALLOWLIST, not a denylist, and that is the point.
      // An earlier version checked createdBy, memberIds and members and said
      // nothing about anything else — so a client could create a household
      // carrying its own `entitlement: {status: "active"}` and take a paid
      // membership for nothing. The update rule below had always forbidden
      // touching entitlement; create had simply never been asked. Found by an
      // adversarial test, 2026-09-24.
      //
      // Anything server-owned — entitlement, Stripe ids, anything added later —
      // is excluded by construction rather than by remembering to name it.
      allow create: if isAuthenticated()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members.keys() == [request.auth.uid]
        && request.resource.data.keys().hasOnly([
             'id', 'createdAt', 'createdBy', 'members', 'memberIds'
           ]);

      // MEMBERSHIP IS NOT CLIENT-WRITABLE. An earlier version required only
      // that the writer remained a member — which let any member remove the
      // founder from the household holding their own animals and keep the
      // pets. Invites and joins already run through Cloud Functions on the
      // Admin SDK, and the client never writes memberIds after creation, so
      // freezing both fields here costs nothing and closes the eviction.
      // Found by an adversarial test, 2026-09-24.
      //
      // And never `entitlement`. That field unlocks member-only surfaces and
      // lives on a document its own members can write, so without this clause
      // anyone could grant themselves a paid membership. It is written only by
      // the Cloud Function that Stripe's signed webhook calls.
      allow update: if lifeIsMember(householdId)
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.memberIds == resource.data.memberIds
        && request.resource.data.members == resource.data.members
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['entitlement']);

      // Deleting a household would strand its pets. Not a thing the client does.
      allow delete: if false;

      match /pets/{petId} {
        allow read, write: if lifeIsMember(householdId);

        // P1 lands records/ and events/ here. They hold vet records, which are
        // sensitive enough that ROADMAP carries a security review as a gate
        // before P1 ships — so they are denied rather than left to a wildcard.
        match /{sub=**} {
          allow read, write: if false;
        }
      }
    }

    // Analytics. Append-only by construction: a client may write its own events
    // and may never read, edit or delete any. The internal dashboard reads them
    // as an admin, using the isAdmin() helper already defined at the top of this
    // file.
    match /life_events/{eventId} {
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // Config: price, feature flags. Written only by the Admin SDK in Cloud
    // Functions, which bypasses these rules entirely.
    match /life_config/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Household invites. NO client access at all, in either direction.
    //
    // An invite code is a key to everything known about someone's pets. If a
    // client could read this collection it could enumerate live codes; if it
    // could write, it could mint itself one for any household. Both halves run
    // in a Cloud Function using the Admin SDK, which bypasses these rules, so
    // the client never needs either.
    match /life_invites/{code} {
      allow read, write: if false;
    }

    // Sitter links (SPEC §6.6). Deny-all in both directions, like invites and
    // for a stronger reason: a token in here is an unauthenticated read key to
    // a pet's care card. Created, listed, read and revoked only by Cloud
    // Functions through the Admin SDK, which bypasses these rules — a client
    // able to read this collection could enumerate every live link on the
    // project.
    match /life_sitter_links/{token} {
      allow read, write: if false;
    }

    match /ai_training_exports/{exportId} {
      allow read: if isAdmin();
      allow write: if false; // Only Cloud Functions can write
    }
  }
}
