rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.userRole == 2;
    }

    function isClaimOwner(claimId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/claims/$(claimId))
        && firestore.get(/databases/(default)/documents/claims/$(claimId)).data.ownerId == request.auth.uid;
    }

    function isPetOwner(petId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/pets/$(petId))
        && firestore.get(/databases/(default)/documents/pets/$(petId)).data.ownerId == request.auth.uid;
    }

    function isPolicyOwner(policyId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/policies/$(policyId))
        && firestore.get(/databases/(default)/documents/policies/$(policyId)).data.ownerId == request.auth.uid;
    }

    function isUnderwritingCaseOwner(caseId) {
      return isAuthenticated()
        && firestore.exists(/databases/(default)/documents/underwriting_cases/$(caseId))
        && firestore.get(/databases/(default)/documents/underwriting_cases/$(caseId)).data.userId == request.auth.uid;
    }

    // Allow authenticated users to upload claim documents
    match /claims/{claimId}/{fileName} {
      allow read: if isAdmin() || isClaimOwner(claimId);
      allow write: if (isAdmin() || isClaimOwner(claimId))
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }
    
    // Allow authenticated users to upload pet images
    match /pets/{petId}/{fileName} {
      allow read: if isAdmin() || isPetOwner(petId);
      allow write: if (isAdmin() || isPetOwner(petId))
                   && request.resource.size < 5 * 1024 * 1024  // Max 5MB
                   && request.resource.contentType.matches('image/.*');
    }
    
    // Allow authenticated users to upload policy documents
    match /policies/{policyId}/{fileName} {
      allow read: if isAdmin() || isPolicyOwner(policyId);
      allow write: if (isAdmin() || isPolicyOwner(policyId))
                   && request.resource.size < 10 * 1024 * 1024  // Max 10MB
                   && request.resource.contentType.matches('image/.*|application/pdf');
    }

    // Underwriting: vet record uploads (PDF + extracted text) are scoped to an underwriting case.
    // Storage paths used by VetHistoryParser:
    // - vet_records/cases/{caseId}/{file}.pdf
    // - vet_records/cases/{caseId}/extracted/{file}.txt
    match /vet_records/cases/{caseId}/{allPaths=**} {
      allow read: if isAdmin() || isUnderwritingCaseOwner(caseId);
      allow write: if (isAdmin() || isUnderwritingCaseOwner(caseId))
                   && request.resource.size < 20 * 1024 * 1024  // Max 20MB for vet PDFs
                   && request.resource.contentType.matches('application/pdf|text/plain');
    }
    
    // Deny all other access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
